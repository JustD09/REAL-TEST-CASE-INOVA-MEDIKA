            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"test_refresh_token\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "variables": [
                {
                  "key": "base_url",
                  "value": "http://localhost:3001"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get User Data",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "variables": [
                {
                  "key": "base_url",
                  "value": "http://localhost:3001"
                },
                {
                  "key": "access_token",
                  "value": "test_access_token"
                }
              ]
            }
          },
          "response": []
        }
      ]
