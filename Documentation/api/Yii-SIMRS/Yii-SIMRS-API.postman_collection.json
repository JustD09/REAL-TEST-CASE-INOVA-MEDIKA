            "body": {
              "mode": "raw",
              "raw": "{\n  \"billing_id\": \"{{billingId}}\",\n  \"amount\": 10000,\n  \"method\": \"cash\",\n  \"reference\": \"DUPLICATE-REF-123\",\n  \"notes\": \"First attempt\"\n}",
              "options": {
