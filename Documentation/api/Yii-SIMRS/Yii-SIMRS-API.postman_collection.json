{
  "info": {
    "_postman_id": "yii-simrs-api-tests",
    "name": "Yii-SIMRS API Tests",
    "description": "Postman collection for testing important transaction APIs: Pembayaran (Payment), Resep (Prescription), Pemeriksaan (Examination)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "user"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/site/login",
              "host": ["{{baseUrl}}"],
              "path": ["site", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Has access token', function () {",
                  "  const response = pm.response.json();",
                  "  if (response.data?.token) {",
                  "    pm.environment.set('authToken', response.data.token);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Pemeriksaan (Examination)",
      "item": [
        {
          "name": "Create Examination",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kunjungan_id\": \"{{kunjunganId}}\",\n  \"dokter_id\": \"{{dokterId}}\",\n  \"anamnesis\": \"Postman test anamnesis\",\n  \"keluhan_utama\": \"Postman keluhan utama\",\n  \"riwayat_penyakit\": \"\",\n  \"riwayat_obat\": \"\",\n  \"riwayat_alergi\": \"\",\n  \"tekanan_darah\": \"120/80\",\n  \"nadi\": \"80\",\n  \"suhu\": \"36.5\",\n  \"respirasi\": \"16\",\n  \"saturasi\": \"98\",\n  \"berat_badan\": \"70\",\n  \"tinggi_badan\": \"175\",\n  \"pemeriksaan_fisik\": \"Postman test pemeriksaan fisik\",\n  \"catatan\": \"Postman test catatan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pemeriksaan",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pemeriksaan"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has examination data', function () {",
                  "  const response = pm.response.json();",
                  "  if (response.data?.id) {",
                  "    pm.environment.set('pemeriksaanId', response.data.id);",
                  "    pm.environment.set('kunjunganId', response.data.kunjungan_id);",
                  "  }",
                  "});",
                  "",
                  "pm.test('Response structure is valid', function () {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response).to.have.property('success', true);",
                  "  pm.expect(response.data).to.have.property('id');",
                  "  pm.expect(response.data).to.have.property('status', 'in_progress');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
