{
    "name": "simrs/simrs-app",
    "description": "SIMRS - Sistem Informasi Manajemen Rumah Sakit",
    "keywords": ["yii2", "simrs", "hospital", "healthcare"],
    "author": "Tianus <tianussembiringmilala@gmail.com> (https://tians4dev.netlify.app)",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues?state=open",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "dompdf/dompdf": "^3.0",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.9",
        "phpoffice/phpspreadsheet": "^3.0",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.6",
        "yiisoft/db-migration": "^1.2",
        "yiisoft/yii2": "~2.0.54",
        "yiisoft/yii2-bootstrap5": "~2.0.2",
        "yiisoft/yii2-redis": "~2.0.0",
        "yiisoft/yii2-symfonymailer": "~2.0.3"
    },
    "require-dev": {
        "codeception/codeception": "^5.0",
        "codeception/module-asserts": "^3.0",
        "codeception/module-yii2": "^1.1",
        "codeception/module-phpbrowser": "^3.0",
        "codeception/module-db": "^3.0",
        "phpunit/phpunit": "^11.0",
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "yiisoft/yii2-faker": "~2.0.0",
        "friendsofphp/php-cs-fixer": "^3.50",
        "phpstan/phpstan": "^2.1",
        "symfony/var-dumper": "^7.0"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "codeception/c3": true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "sort-packages": true,
        "policy": {
            "advisories": {
                "ignore-id": ["PKSA-y2cr-5h3j-g3ys"]
            }
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject"
        ],
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "cs-fix": "php-cs-fixer fix --allow-risky=yes",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "static": "phpstan analyse --memory-limit=512M",
        "test": "codecept run",
        "test-unit": "codecept run unit",
        "test-functional": "codecept run functional",
        "test-acceptance": "codecept run acceptance"
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ],
            "generateCookieValidationKey": [
                "common/config/main-local.php",
                "frontend/config/main-local.php",
                "backend/config/main-local.php",
                "api/config/main-local.php"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "common\\": "common/",
            "frontend\\": "frontend/",
            "backend\\": "backend/",
            "api\\": "api/",
            "console\\": "console/"
        }
    }
}
