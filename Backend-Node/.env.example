# Backend-Node Environment Template
# Copy to .env and adjust values

# App
APP_ENV=development
NODE_ENV=development
PORT=3001

# PostgreSQL DB
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=simrs_db
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=20
DB_SSL=false

# Redis (via WSL port proxy localhost:6379 -> WSL:6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET=generate_strong_random_secret_here
JWT_REFRESH_SECRET=generate_strong_random_refresh_secret_here

# CORS
CORS_ORIGIN=https://localhost,http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# BPJS Kesehatan API
BPJS_BASE_URL=https://api.bpjs-kesehatan.go.id
BPJS_CONS_ID=
BPJS_SECRET=

# SATUSEHAT API
SATUSEHAT_BASE_URL=https://api.satusehat.kemkes.go.id
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
